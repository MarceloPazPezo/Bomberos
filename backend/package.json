    "eslint-config-google": "0.14.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.4.0",
    "nodemon": "3.1.10",
    "prettier": "3.5.3",
    "vitest": "3.1.3"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
