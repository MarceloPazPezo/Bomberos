# ===========================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA BOMBEROS
# ===========================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo como .env: cp .env.example .env
# 2. Ajusta los valores según tu entorno (local o Docker)
# 3. IMPORTANTE: Si ejecutas LOCALMENTE, usa localhost
#    Si ejecutas con DOCKER, usa los nombres de los servicios
# ===========================================

# ===========================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND
# ===========================================
NODE_ENV=development
# NODE_ENV=production  # Para producción

# Host y puerto del backend
# Puedes usar cualquiera de estos dos formatos:
HOST=0.0.0.0
PORT=3000
# O alternativamente:
# B_HOST=0.0.0.0
# B_PORT=3000

# ===========================================
# SEGURIDAD (JWT y Cookies)
# ===========================================
# IMPORTANTE: Cambia estos valores en producción por valores seguros
# Puedes usar cualquiera de estos dos formatos:
ACCESS_TOKEN_SECRET=your-super-secret-jwt-token-change-in-production
COOKIE_KEY=your-super-secret-cookie-key-change-in-production
# O alternativamente:
# B_ACCESS_TOKEN_SECRET=your-super-secret-jwt-token-change-in-production
# B_COOKIE_KEY=your-super-secret-cookie-key-change-in-production

# ===========================================
# BASE DE DATOS (PostgreSQL + PostGIS)
# ===========================================
# IMPORTANTE: 
# - Si ejecutas LOCALMENTE: usa localhost
# - Si ejecutas con DOCKER: usa database (nombre del servicio)

# Host de la base de datos
# Para ejecución LOCAL:
DB_HOST=localhost
# Para ejecución con DOCKER, descomenta esta línea:
# DB_HOST=database

# Puerto de PostgreSQL (normalmente 5432)
DB_PORT=5432
# Si tu PostgreSQL está en otro puerto, cámbialo:
# DB_PORT=5433

# Credenciales de la base de datos
DB_USERNAME=user_bomberos
# Puedes usar cualquiera de estas dos variables para la contraseña:
DB_PASSWORD=password_bomberos
# O alternativamente:
# PASSWORD=password_bomberos

# Nombre de la base de datos
# Puedes usar cualquiera de estas dos variables:
DATABASE=db_bomberos
# O alternativamente:
# DB_NAME=db_bomberos

# ===========================================
# REDIS (Cache y Notificaciones)
# ===========================================
# IMPORTANTE: 
# - Si ejecutas LOCALMENTE: usa localhost
# - Si ejecutas con DOCKER: usa redis (nombre del servicio)

# Host de Redis
# Para ejecución LOCAL:
REDIS_HOST=localhost
# Para ejecución con DOCKER, descomenta esta línea:
# REDIS_HOST=redis

REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# MINIO (Almacenamiento de Archivos)
# ===========================================
# IMPORTANTE: 
# - Si ejecutas LOCALMENTE: usa localhost
# - Si ejecutas con DOCKER: usa minio (nombre del servicio)

# Endpoint de MinIO
# Para ejecución LOCAL:
MINIO_ENDPOINT=localhost
# Para ejecución con DOCKER, descomenta esta línea:
# MINIO_ENDPOINT=minio

MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=uploads
SIGNED_URL_EXPIRY=3600

# URL pública de MinIO para URLs firmadas (accesible desde el navegador)
# Si no se especifica, se construye automáticamente usando localhost:EXTERNAL_MINIO_PORT
# Para desarrollo local, dejar vacío o usar: http://localhost:9000
# Para producción, usar el dominio completo: http://minio.tudominio.com:9000
MINIO_PUBLIC_URL=
MINIO_PUBLIC_PORT=9000

# ===========================================
# CONFIGURACIÓN DEL FRONTEND (VITE)
# ===========================================
# URL base del backend (sin /api)
VITE_BASE_URL=

# URL completa de la API (usar /api en producción con Docker)
VITE_API_URL=/api

# URL para WebSocket/Socket.IO
VITE_SOCKET_URL=

# URL del backend para proxy en desarrollo
VITE_BACKEND_URL=http://localhost:3000

# ===========================================
# CONFIGURACIÓN DE DOCKER COMPOSE
# ===========================================
# Puertos externos para acceso desde el host
# Solo necesarios si usas Docker Compose
EXTERNAL_BACKEND_PORT=3000
EXTERNAL_FRONTEND_PORT=80
EXTERNAL_FRONTEND_SSL_PORT=443
EXTERNAL_DB_PORT=5432
EXTERNAL_MINIO_PORT=9000
EXTERNAL_MINIO_CONSOLE_PORT=9001
EXTERNAL_REDIS_PORT=6379

# ===========================================
# CONFIGURACIÓN DE LIMPIEZA AUTOMÁTICA
# ===========================================
CLEANUP_INTERVAL=3600000
CLEANUP_BATCH_SIZE=100

# ===========================================
# CONFIGURACIÓN DE TTL DE NOTIFICACIONES
# ===========================================
NOTIFICATION_TTL_CRITICAL=604800      # 7 días
NOTIFICATION_TTL_EMERGENCY=259200     # 3 días
NOTIFICATION_TTL_PERSONAL=2592000     # 30 días
NOTIFICATION_TTL_REMINDER=604800      # 7 días
NOTIFICATION_TTL_DIRECT_MESSAGE=1209600 # 14 días
NOTIFICATION_TTL_SYSTEM=259200        # 3 días
NOTIFICATION_TTL_READ=86400           # 1 día

# ===========================================
# CONFIGURACIÓN DE OPTIMIZACIÓN
# ===========================================
COMPRESS_AFTER_DAYS=7                 # Comprimir después de 7 días
DELETE_READ_AFTER_DAYS=7              # Eliminar leídas después de 7 días
MAX_NOTIFICATIONS_PER_USER=50         # Máximo 50 notificaciones por usuario

# ===========================================
# NOTAS IMPORTANTES
# ===========================================
# 
# 1. VARIABLES ALTERNATIVAS:
#    - DB_PASSWORD o PASSWORD (ambos funcionan)
#    - DB_NAME o DATABASE (ambos funcionan)
#    - HOST o B_HOST (ambos funcionan)
#    - PORT o B_PORT (ambos funcionan)
#    - ACCESS_TOKEN_SECRET o B_ACCESS_TOKEN_SECRET (ambos funcionan)
#    - COOKIE_KEY o B_COOKIE_KEY (ambos funcionan)
#
# 2. EJECUCIÓN LOCAL vs DOCKER:
#    - LOCAL: DB_HOST=localhost, REDIS_HOST=localhost, MINIO_ENDPOINT=localhost
#    - DOCKER: DB_HOST=database, REDIS_HOST=redis, MINIO_ENDPOINT=minio
#
# 3. REQUISITOS PARA EJECUCIÓN LOCAL:
#    - PostgreSQL con PostGIS instalado y corriendo
#    - Redis instalado y corriendo (redis-server)
#    - MinIO instalado y corriendo (opcional, puede usar Docker solo para MinIO)
#    - Base de datos creada: CREATE DATABASE db_bomberos;
#
# 4. UBICACIÓN DEL ARCHIVO:
#    - El .env debe estar en la RAÍZ del proyecto (no en backend/.env)
#    - El backend lo busca en: ../../../.env desde backend/src/config/
#
# 5. SEGURIDAD:
#    - NUNCA subas el archivo .env al repositorio
#    - Cambia todos los secretos en producción
#    - Usa variables de entorno del sistema en producción (no archivo .env)
