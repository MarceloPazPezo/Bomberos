# ===========================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ===========================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo a .env: cp .env.example .env
# 2. Completa los valores necesarios según tu entorno
# 3. En PRODUCCIÓN, CAMBIA TODOS los secretos y contraseñas por defecto
# 
# ===========================================
# CONFIGURACIÓN GENERAL
# ===========================================

# Entorno de ejecución: 'development' o 'production'
# En producción, el sistema valida que los secretos sean seguros
NODE_ENV=production
# NODE_ENV=development  # Descomenta para desarrollo local

# ===========================================
# CONFIGURACIÓN DEL BACKEND
# ===========================================

# Host y puerto donde el backend escuchará las conexiones
# En Docker, usar 0.0.0.0 para aceptar conexiones de cualquier interfaz
B_HOST=0.0.0.0
B_PORT=3000

# Variables alternativas (el backend acepta ambas)
HOST=0.0.0.0
PORT=3000

# ===========================================
# SEGURIDAD DEL BACKEND (¡CRÍTICO EN PRODUCCIÓN!)
# ===========================================

# Secreto para firmar y verificar tokens JWT
# ⚠️ IMPORTANTE: Genera un secreto seguro en producción
# Generar con: openssl rand -base64 32
B_ACCESS_TOKEN_SECRET=your-super-secret-jwt-token-change-in-production
ACCESS_TOKEN_SECRET=your-super-secret-jwt-token-change-in-production

# Clave secreta para cookies de sesión
# ⚠️ IMPORTANTE: Genera una clave segura en producción
# Generar con: openssl rand -base64 32
B_COOKIE_KEY=your-super-secret-cookie-key-change-in-production
COOKIE_KEY=your-super-secret-cookie-key-change-in-production

# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL + PostGIS)
# ===========================================

# Host de la base de datos
# En Docker Compose, usar el nombre del servicio: 'database'
# Para conexión externa: 'localhost' o IP del servidor
DB_HOST=database
DB_PORT=5432

# Nombre de la base de datos
DB_NAME=db_bomberos
DATABASE=db_bomberos

# Credenciales de la base de datos
# ⚠️ IMPORTANTE: Cambia la contraseña en producción
# Generar con: openssl rand -base64 24
DB_USERNAME=user_bomberos
DB_PASSWORD=password_bomberos
PASSWORD=password_bomberos

# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS DE TESTING
# ===========================================
# Estas variables se usan cuando NODE_ENV=test
# Opcional: Solo necesario si ejecutas tests que requieren BD

DB_TEST_HOST=database_test
DB_TEST_NAME=db_bomberos_test
DB_TEST_PORT=5432
DB_TEST_USERNAME=user_bomberos_test
DB_TEST_PASSWORD=password_bomberos_test

# ===========================================
# CONFIGURACIÓN DE REDIS
# ===========================================

# Host de Redis
# En Docker Compose, usar el nombre del servicio: 'redis'
# Para conexión externa: 'localhost' o IP del servidor
REDIS_HOST=redis
REDIS_PORT=6379

# Contraseña de Redis (opcional pero recomendado en producción)
# Si se deja vacío, Redis no requerirá contraseña
# ⚠️ IMPORTANTE: En producción, configura una contraseña segura
# Generar con: openssl rand -base64 24
REDIS_PASSWORD=

# Base de datos Redis (0-15, por defecto 0)
REDIS_DB=0

# ===========================================
# CONFIGURACIÓN DE MINIO (Almacenamiento de Archivos S3)
# ===========================================

# Endpoint de MinIO
# En Docker Compose, usar el nombre del servicio: 'minio'
# Para conexión externa: 'localhost' o IP del servidor
MINIO_ENDPOINT=minio
MINIO_PORT=9000

# Usar SSL/TLS (true/false)
# En desarrollo local generalmente es 'false'
# En producción con certificados válidos: 'true'
MINIO_USE_SSL=false

# Credenciales de MinIO
# ⚠️ IMPORTANTE: Cambia estas credenciales en producción
# Por defecto: minioadmin / minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Nombre del bucket principal
# Los buckets adicionales se crean automáticamente:
# - {BUCKET_NAME}-perfiles
# - {BUCKET_NAME}-companias
# - {BUCKET_NAME}-documentos
# - {BUCKET_NAME}-teselas-publicas
# - {BUCKET_NAME}-teselas-privadas
MINIO_BUCKET_NAME=uploads

# URL pública de MinIO para URLs firmadas (accesible desde el navegador)
# Si no se especifica, se construye automáticamente usando localhost:EXTERNAL_MINIO_PORT
# Para producción, usar el dominio completo: http://minio.tudominio.com:9000
# Ejemplo desarrollo: http://localhost:9000
MINIO_PUBLIC_URL=
MINIO_PUBLIC_PORT=9000

# Tiempo de expiración de URLs firmadas (en segundos)
# Por defecto: 3600 segundos (1 hora)
SIGNED_URL_EXPIRY=3600

# ===========================================
# CONFIGURACIÓN DEL FRONTEND (VITE)
# ===========================================

# URL base del backend (sin /api)
# En producción con Docker, dejar vacío o usar ruta relativa
# El frontend usa Nginx como proxy, por lo que /api se redirige automáticamente
VITE_BASE_URL=

# URL completa de la API
# En producción con Docker: usar /api (ruta relativa que pasa por nginx)
# Para desarrollo local: http://localhost:3000/api
VITE_API_URL=/api

# URL para WebSocket/Socket.IO
# En producción con Docker, dejar vacío (usará la misma URL base)
# Para desarrollo local: http://localhost:3000
# El frontend detecta automáticamente la URL base si está vacío
VITE_SOCKET_URL=

# URL del backend para proxy en desarrollo (solo para desarrollo local)
# En producción no se usa, pero se puede dejar para referencia
# Vite usa esta URL para el proxy cuando corres 'npm run dev'
VITE_BACKEND_URL=http://localhost:3000

# ===========================================
# PUERTOS EXTERNOS (para acceso desde el host)
# ===========================================
# Estos puertos son los que se exponen en tu máquina local
# Cambia estos valores si hay conflictos con otros servicios

# Puerto de PostgreSQL (acceso desde el host)
# Por defecto: 5432
# Si ya tienes PostgreSQL local, cambia a otro puerto (ej: 5433)
EXTERNAL_DB_PORT=5432

# Puerto de PostgreSQL para testing (acceso desde el host)
# Por defecto: 5434
EXTERNAL_DB_TEST_PORT=5434

# Puerto de Redis (acceso desde el host)
# Por defecto: 6379
# Si ya tienes Redis local, cambia a otro puerto (ej: 6380)
EXTERNAL_REDIS_PORT=6379

# Puerto de MinIO API (acceso desde el host)
# Por defecto: 9000
# Si ya tienes MinIO local, cambia a otro puerto (ej: 9001)
EXTERNAL_MINIO_PORT=9000

# Puerto de MinIO Console (interfaz web)
# Por defecto: 9002
# Acceso: http://localhost:9002
EXTERNAL_MINIO_CONSOLE_PORT=9002

# Puerto del Backend API (acceso desde el host)
# Por defecto: 3000
# Si ya tienes otro servicio en 3000, cambia a otro puerto (ej: 3001)
EXTERNAL_BACKEND_PORT=3000

# Puerto del Frontend HTTP (acceso desde el host)
# Por defecto: 80
# Requiere permisos de administrador en Linux/Mac
# Si no tienes permisos, cambia a otro puerto (ej: 8080)
EXTERNAL_FRONTEND_PORT=80

# Puerto del Frontend HTTPS (acceso desde el host)
# Por defecto: 443
# Requiere permisos de administrador y certificados SSL
# Si no tienes certificados, deja este puerto sin usar
EXTERNAL_FRONTEND_SSL_PORT=443

# ===========================================
# CONFIGURACIÓN OPCIONAL
# ===========================================

# Intervalo de limpieza automática (en milisegundos)
# Por defecto: 3600000 (1 hora)
# Sistema de limpieza automática de notificaciones antiguas
CLEANUP_INTERVAL=3600000

# Tamaño de lote para limpieza
# Por defecto: 100
# Cantidad de registros a procesar por lote en la limpieza
CLEANUP_BATCH_SIZE=100

# ===========================================
# NOTAS IMPORTANTES
# ===========================================
#
# 1. SEGURIDAD:
#    - En producción, CAMBIA TODOS los secretos y contraseñas
#    - Usa contraseñas fuertes (mínimo 16 caracteres)
#    - No compartas este archivo .env en el repositorio
#
# 2. PUERTOS:
#    - Verifica que los puertos no estén en uso antes de levantar servicios
#    - Usa: netstat -tuln | grep -E ':(80|3000|5432|6379|9000|9002)'
#
# 3. DOCKER:
#    - Los servicios se comunican entre sí usando nombres de servicio
#    - DB_HOST=database, REDIS_HOST=redis, MINIO_ENDPOINT=minio
#    - Los puertos EXTERNAL_* son solo para acceso desde tu máquina
#
# 4. DESARROLLO:
#    - Para desarrollo local sin Docker, cambia los hosts a 'localhost'
#    - Asegúrate de tener PostgreSQL, Redis y MinIO corriendo localmente
#
# 5. PRODUCCIÓN:
#    - Configura certificados SSL para HTTPS
#    - Usa un servidor de producción para PostgreSQL (no Docker)
#    - Configura backups automáticos de la base de datos
#    - Monitorea los logs regularmente
#
# ===========================================
